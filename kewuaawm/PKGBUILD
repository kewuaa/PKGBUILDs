pkgname=kewuaawm
pkgver=1.0
pkgrel=1
arch=("x86_64")
depends=(
    # window manager
    "river"
    # "playerctl"
    # font
    "ttf-firacode-nerd"
    # adjust light
    "brightnessctl"
    # adjust volume
    "wireplumber"
    # default terminal
    "foot"
    # terminal file manager
    "lf"
    # power manager
    "wlopm"
    # outputs config
    "wlr-randr" "kanshi"
    # screen lock
    "swayidle" "waylock"
    # menu
    "wmenu"
    # wallpaper manager
    "swaybg"
    # screen shot
    "slurp" "grim"
    # Day/night gamma adjustments
    "gammastep"
    # clipboard support
    "wl-clipboard" "cliphist"
    # screen share
    "xdg-desktop-portal-wlr"
    # notification daemon
    "mako"
    "wob"
    # notification
    "libnotify"
    # inhibit
    "wayland-pipewire-idle-inhibit"
    # fcitx5
    "fcitx5" "fcitx5-chinese-addons" "fcitx5-configtool"
)
optdepends=(
    "swayimg: image viewer"
    "bat: replacement of cat"
    "mpv: video player"
    "wf-recorder: screen recorder"
    "lswt: list wayland toplevels"
    "stalonetray: standalone system tray"
    "timeshift: system snapshot"
    "cpupower: cpu frequency scaling"
    "chafa: image preview support for lf"
    "poppler: pdf preview support for lf"
    "wshowkeys-mao-git: show keys on screen"
    "wl-mirror: "
    "pipectl: "
)
makedepends=(
    "gcc"
    "pkgconf"
    "wayland-protocols"
    "tllist"
    "fcft"
    "pixman"
    "libxkbcommon"
    "ninja"
    "zig"
)


build() {
    [ -d "$srcdir/kwm" ] || git clone https://github.com/kewuaa/kwm "$srcdir/kwm"
    [ -d "$srcdir/kwim" ] || git clone https://github.com/kewuaa/kwim "$srcdir/kwim"

    cp "$srcdir/../kwm.zon" "$srcdir/kwm/config.zon"
    cp "$srcdir/../kwim.zon" "$srcdir/kwim/config.zon"
}


package() {
    echo 'packaging kewuaawm'

    cd ${srcdir}/kwm
    DESTDIR="$pkgdir" zig build install --release=safe
    cd ${srcdir}/kwim
    DESTDIR="$pkgdir" zig build install -Dconfig="config.zon" --release=safe
}
